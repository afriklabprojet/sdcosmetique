#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

echo "==> Updating API dependencies (composer update)..."
cd "${ROOT_DIR}/api"
composer update

echo "==> Updating Web dependencies (pnpm update)..."
cd "${ROOT_DIR}/web"
pnpm update

echo "==> Dependencies updated successfully!"
