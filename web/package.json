{
  "name": "sd-cosmetique",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev --webpack",
    "build": "next build --webpack",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:sidebar": "playwright test tests/admin-sidebar.spec.ts"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "next": "16.2.11",
    "rate-limiter-flexible": "11.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "smol-toml": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": ">=8.5.26",
    "sharp": ">=0.35.3"
