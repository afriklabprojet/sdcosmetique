# Next.js storefront + admin. All data comes from the Laravel API.

NEXT_PUBLIC_API_URL="http://localhost:8000/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SD Cosmétique"

# Shared with api/.env WEB_REVALIDATE_SECRET. Laravel observers POST /api/revalidate with this header.
REVALIDATE_SECRET="generate-a-64-char-hex-secret"

# Mode maintenance (voir src/middleware.ts) : l'admin active/désactive le mode
# maintenance depuis le tableau de bord (Marketing Bulk > ... non, Boutique >
# Maintenance) — ça bloque tous les visiteurs avec une page "site en
# maintenance". Cette variable, elle, sert UNIQUEMENT à VOUS (le développeur)
# pour continuer à voir le site normalement pendant que tout le monde voit la
# page de maintenance : ouvrez https://votre-site/?preview=LA_VALEUR_CI_DESSOUS
# une fois, un cookie garde l'accès pendant 7 jours. Générez une vraie valeur
# aléatoire (ex. `openssl rand -hex 24`) et ne la partagez jamais publiquement.
MAINTENANCE_BYPASS_SECRET="generate-a-random-secret"
