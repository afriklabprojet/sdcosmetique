# ─── Base de données MariaDB / MySQL ───
DATABASE_URL="mysql://sdcosmetique_user:sdcosmetique_pass@127.0.0.1:3306/sdcosmetique"
# Ou paramètres individuels :
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=sdcosmetique_user
# DB_PASSWORD=sdcosmetique_pass
# DB_NAME=sdcosmetique

# ─── Authentification & Sécurité ───
AUTH_SECRET="your-super-secret-32-character-auth-secret-key"
ADMIN_EMAILS="contact@sdcosmetique.com,admin@sdcosmetique.com"
ADMIN_DEFAULT_PASSWORD="Admin@SDZ2026!"

# ─── Paiement Jeko Pay ───
JEKO_API_KEY="jeko_test_..."
JEKO_STORE_ID="store_..."
JEKO_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Laravel API (Sanctum SPA). Browser calls this origin with credentials.
# The same admin email must exist in both the Laravel AdminSeeder and the Next users table
# until M6 deletes leftover Drizzle admin routes.
NEXT_PUBLIC_API_URL="http://localhost:8000/api"

# ─── Emails & Notifications (Resend / SMTP) ───
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="SD Cosmétique <contact@sdcosmetique.com>"
ADMIN_NOTIFICATION_EMAIL="contact@sdcosmetique.com"

# ─── Tâches de fond (Cron) ───
CRON_SECRET="your-cron-secret-key"
